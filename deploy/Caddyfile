{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Better Auth: keep the /api/auth/* prefix intact.
	handle /api/auth/* {
		reverse_proxy api:3001
	}

	# Everything else under /api -> strip the /api prefix before proxying.
	# WebSocket upgrade is preserved automatically in Caddy v2.
	handle_path /api/* {
		reverse_proxy api:3001
	}

	# SPA — files baked into this image at /srv.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
