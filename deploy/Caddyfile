{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Custom routes mounted at /auth/* on the API (NOT Better Auth itself):
	#   - /api/auth/me            -> /auth/me
	#   - /api/auth/switch-tenant -> /auth/switch-tenant
	# Strip /api so the API hits its actual mount path.
	@custom_auth path /api/auth/me /api/auth/switch-tenant
	handle @custom_auth {
		uri strip_prefix /api
		reverse_proxy api:3001
	}

	# Better Auth's own handler: keep the /api/auth/* prefix intact
	# (sign-in, sign-up, sign-out, get-session, etc.).
	handle /api/auth/* {
		reverse_proxy api:3001
	}

	# Everything else under /api -> strip the /api prefix before proxying.
	# WebSocket upgrade is preserved automatically in Caddy v2.
	handle_path /api/* {
		reverse_proxy api:3001
	}

	# SPA — files baked into this image at /srv.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
