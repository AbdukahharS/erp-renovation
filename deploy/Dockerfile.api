# syntax=docker/dockerfile:1.7
ARG BUN_VERSION=1.3.14

FROM oven/bun:${BUN_VERSION}-alpine AS deps
WORKDIR /app
COPY package.json bun.lock bunfig.toml turbo.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/queue/package.json packages/queue/package.json
COPY packages/validators/package.json packages/validators/package.json
COPY packages/acceptance/package.json packages/acceptance/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/typescript-config/package.json packages/typescript-config/package.json
RUN bun install --frozen-lockfile

FROM deps AS runtime
WORKDIR /app
ENV NODE_ENV=production
# Bun runs TypeScript natively; skip bundling. `bun build --target bun`
# inlines `import.meta.dir` to the bundle output location, which breaks
# any source that resolves a path relative to its own source file
# (e.g. packages/db/src/migrations/fanout.ts pointing at drizzle/tenant).
COPY apps/api ./apps/api
COPY packages ./packages
COPY scripts ./scripts
WORKDIR /app/apps/api
EXPOSE 3001
CMD ["bun", "src/index.ts"]
