# syntax=docker/dockerfile:1.7
ARG BUN_VERSION=1.3.14

FROM oven/bun:${BUN_VERSION}-alpine AS deps
WORKDIR /app
COPY package.json bun.lock bunfig.toml turbo.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/queue/package.json packages/queue/package.json
COPY packages/validators/package.json packages/validators/package.json
COPY packages/acceptance/package.json packages/acceptance/package.json
COPY packages/typescript-config/package.json packages/typescript-config/package.json
RUN bun install --frozen-lockfile

FROM deps AS build
COPY . .
WORKDIR /app/apps/api
RUN bun build src/index.ts --outdir dist --target bun

FROM oven/bun:${BUN_VERSION}-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
# wget is used by the compose healthcheck; alpine ships it via busybox already.
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/apps/api/node_modules /app/apps/api/node_modules
COPY --from=build /app/apps/api/dist /app/apps/api/dist
COPY --from=build /app/apps/api/package.json /app/apps/api/package.json
COPY --from=build /app/packages /app/packages
COPY --from=build /app/scripts /app/scripts
WORKDIR /app/apps/api
EXPOSE 3001
# Avoid package.json "start" — it loads ../../.env which isn't present.
CMD ["bun", "dist/index.js"]
