# syntax=docker/dockerfile:1.7
ARG BUN_VERSION=1.3.14

FROM oven/bun:${BUN_VERSION}-alpine AS deps
WORKDIR /app
COPY package.json bun.lock bunfig.toml turbo.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/queue/package.json packages/queue/package.json
COPY packages/validators/package.json packages/validators/package.json
COPY packages/acceptance/package.json packages/acceptance/package.json
COPY packages/typescript-config/package.json packages/typescript-config/package.json
RUN bun install --frozen-lockfile

FROM deps AS build
ARG VITE_API_URL=/api
ARG VITE_VAPID_PUBLIC_KEY=""
COPY . .
# Vite's envDir is the repo root (apps/web/vite.config.ts: envDir = ../..).
# Materialize a .env there from build args so Vite picks up VITE_* values.
RUN printf "VITE_API_URL=%s\nVITE_VAPID_PUBLIC_KEY=%s\n" \
	"$VITE_API_URL" "$VITE_VAPID_PUBLIC_KEY" > /app/.env
WORKDIR /app/apps/web
# Generate routeTree.gen.ts before tsc -b runs (the build script doesn't do
# this; locally it persists, but a clean Docker build has no copy).
RUN bun run generate:routes && bun run build

FROM caddy:2-alpine AS runtime
COPY --from=build /app/apps/web/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
