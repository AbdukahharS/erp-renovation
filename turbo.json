{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"globalPassThroughEnv": [
		"DATABASE_URL",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"BOOTSTRAP_TOKEN",
		"REDIS_URL",
		"PORT",
		"CORS_ORIGINS",
		"R2_ENDPOINT",
		"R2_ACCESS_KEY_ID",
		"R2_SECRET_ACCESS_KEY",
		"R2_BUCKET",
		"R2_PUBLIC_URL",
		"R2_PRESIGN_EXPIRES_SECONDS",
		"VITE_API_URL"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"db:generate:control": {
			"cache": false
		},
		"db:generate:tenant": {
			"cache": false
		},
		"db:migrate:control": {
			"cache": false
		},
		"db:migrate:tenants": {
			"cache": false
		}
	}
}
