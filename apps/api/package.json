{
	"name": "api",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/index.ts"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/eden": "^1.4.9",
		"@repo/db": "workspace:*",
		"@repo/validators": "workspace:*",
		"better-auth": "^1.6.11",
		"drizzle-orm": "^0.45.2",
		"elysia": "^1.4.28"
	},
	"scripts": {
		"dev": "bun --env-file=../../.env --watch src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"start": "bun --env-file=../../.env dist/index.js",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "bun --env-file=../../.env test"
	}
}
