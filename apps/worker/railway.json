{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "NIXPACKS",
		"buildCommand": "bun install --frozen-lockfile && bun run --filter worker build"
	},
	"deploy": {
		"startCommand": "bun run --filter worker start",
		"restartPolicyType": "ON_FAILURE",
		"restartPolicyMaxRetries": 10
	}
}
