{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"useDefineForClassFields": true,
		"types": ["vite/client"]
	}
}
