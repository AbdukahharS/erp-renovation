{
	"name": "@repo/db",
	"type": "module",
	"private": true,
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@types/bun": "latest",
		"drizzle-kit": "^0.31.10"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9"
	},
	"scripts": {
		"lint": "biome check .",
		"db:generate:control": "bun --env-file=../../.env x drizzle-kit generate --config=drizzle.control.config.ts",
		"db:generate:tenant": "bun --env-file=../../.env x drizzle-kit generate --config=drizzle.tenant.config.ts && bun scripts/strip-public-qualifier.ts",
		"db:migrate:control": "bun --env-file=../../.env src/migrations/control.ts",
		"db:migrate:tenants": "bun --env-file=../../.env src/migrations/fanout.ts",
		"db:studio": "set -a; . ../../.env; bunx drizzle-kit studio --config=drizzle.studio.config.ts",
		"typecheck": "tsc --noEmit"
	},
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema/index.ts",
		"./schema/control": "./src/schema/control.ts",
		"./schema/tenant": "./src/schema/tenant.ts",
		"./client": "./src/client.ts",
		"./provision": "./src/provision.ts",
		"./with-tenant": "./src/with-tenant.ts",
		"./instantiate-template": "./src/instantiate-template.ts"
	}
}
