{
	"name": "erp",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"db:generate:control": "turbo run db:generate:control",
		"db:generate:tenant": "turbo run db:generate:tenant",
		"db:migrate:control": "turbo run db:migrate:control",
		"db:migrate:tenants": "turbo run db:migrate:tenants"
	},
	"dependencies": {
		"@repo/db": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"turbo": "^2.9.14",
		"typescript": "5.9.2"
	},
	"engines": {
		"bun": "1.3.14",
		"node": "22.x"
	},
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
