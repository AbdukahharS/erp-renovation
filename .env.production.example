# Copy to .env.production on the VPS (chmod 600). Loaded by docker compose
# via --env-file and mounted into api/worker/migrate via env_file.

# --- Compose interpolation & Caddy ---
DOMAIN=erp.example.com
ACME_EMAIL=ops@example.com

# --- Postgres (also used to build DATABASE_URL below) ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=erp

# --- Runtime env consumed by api / worker / migrate ---
DATABASE_URL=postgres://erp:CHANGE_ME_LONG_RANDOM@postgres:5432/erp
REDIS_URL=redis://redis:6379

PORT=3001
NODE_ENV=production

# Same-origin: the browser only ever hits https://DOMAIN, so /api/* is same-origin.
CORS_ORIGINS=https://erp.example.com

# >= 32 chars. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=GENERATE_WITH_openssl_rand_base64_48
# Origin only (no /api suffix). Better Auth uses its own basePath
# (default /api/auth) internally; including /api here makes it strip
# /api from incoming paths and 404 every auth endpoint.
BETTER_AUTH_URL=https://erp.example.com
BOOTSTRAP_TOKEN=CHANGE_ME

# --- R2 / S3 storage ---
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=erp-prod
R2_PUBLIC_URL=
R2_PRESIGN_EXPIRES_SECONDS=900

# --- Web Push / VAPID (server side) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
# Baked into the SPA at build time via the compose build arg on the caddy service.
VITE_VAPID_PUBLIC_KEY=

# Optional Sentry/Logtail/Slack webhook for uncaught 5xx errors.
ERROR_REPORTER_URL=

# Note: VITE_API_URL is NOT here — it's hard-coded to "/api" as a compose
# build arg because the same-origin mount never changes per environment.
