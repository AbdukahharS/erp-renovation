# Local dev defaults — pair with `docker-compose up -d`.
DATABASE_URL=postgres://erp:erp@localhost:5433/erp
REDIS_URL=redis://localhost:6379

# API
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Auth (Phase 1)
# >= 32 chars in production. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-secret-change-me-please-32+chars
BETTER_AUTH_URL=http://localhost:3001
# Header value required for POST /tenants until super-admin role exists (Phase 9).
BOOTSTRAP_TOKEN=dev-bootstrap-token

# Public property share-link JWT signing secret. >= 16 chars. Used to issue
# short-lived session tokens after a customer enters the link password.
SHARE_LINK_JWT_SECRET=dev-only-share-link-secret-change-me

# Public-facing app origin used to construct share-link URLs returned to the
# Owner (e.g. https://app.example.com → /p/{tenantSlug}/{slug}).
PUBLIC_APP_URL=http://localhost:3000

# Web (Vite-exposed)
VITE_API_URL=http://localhost:3001

# R2 / S3 storage (Phase 3). Empty values disable presigned uploads (routes 503).
# For local dev, MinIO works: set R2_ENDPOINT=http://localhost:9000 and add a
# minio service to docker-compose.yml.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=erp-dev
R2_PUBLIC_URL=
R2_PRESIGN_EXPIRES_SECONDS=900

# Web Push / VAPID (Phase 8). Empty values disable push delivery (in-app
# notifications still work). Generate keys with:
#   cd apps/api && bun scripts/generate-vapid.ts
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
# Web-exposed: the SW reads this at runtime to call pushManager.subscribe.
VITE_VAPID_PUBLIC_KEY=

# Phase 9 — production deploy
# NODE_ENV=production toggles secure cookies in Better Auth.
# NODE_ENV=development
# ERROR_REPORTER_URL: optional webhook (Sentry/Logtail/Slack) for uncaught
# errors. Empty disables forwarding; structured logs are always emitted.
ERROR_REPORTER_URL=
