# Local dev defaults — pair with `docker-compose up -d`.
DATABASE_URL=postgres://erp:erp@localhost:5433/erp
REDIS_URL=redis://localhost:6379

# API
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Auth (Phase 1)
# >= 32 chars in production. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-secret-change-me-please-32+chars
BETTER_AUTH_URL=http://localhost:3001
# Header value required for POST /tenants until super-admin role exists (Phase 9).
BOOTSTRAP_TOKEN=dev-bootstrap-token

# Web (Vite-exposed)
VITE_API_URL=http://localhost:3001

# R2 / S3 storage (Phase 3). Empty values disable presigned uploads (routes 503).
# For local dev, MinIO works: set R2_ENDPOINT=http://localhost:9000 and add a
# minio service to docker-compose.yml.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=erp-dev
R2_PUBLIC_URL=
R2_PRESIGN_EXPIRES_SECONDS=900
